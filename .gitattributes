# Normalise line endings so Android/Windows/CI see identical file content.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ttf  binary
*.otf  binary
*.ico  binary
*.pdf  binary
*.xlsx binary
*.keystore binary
*.jks  binary
